# Copy to .env.local — never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used solely by Admin → Create User (Supabase Auth Admin API).
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL, used as the redirect in admin-sent password reset links
# and in secure download links for large email packages.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email delivery (Resend). Emails go only to Admin → Email Delivery → Company Email Recipients.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="Level Up Buildcon <documents@levelupbuildcon.com>"

# Optional. Resend → Webhooks → signing secret (whsec_...). Enables "Delivered" / "Bounced" in Email History.
# Endpoint to register: <NEXT_PUBLIC_APP_URL>/api/webhooks/resend (events: delivered, delivery_delayed, bounced, complained, failed).
RESEND_WEBHOOK_SECRET=

# Optional. Bearer secret for a hosted scheduler calling GET or POST /api/cron/demand-notes.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional. Signs expiring download links for packages too large to attach.
# Generate with: openssl rand -hex 32  (derived from the service key when unset)
EMAIL_LINK_SECRET=

# Optional. Resend free plan limits (each recipient counts as one email).
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000

# Optional. true = queue emails but do not send. EMAIL_SENDER=mock records instead of sending.
EMAIL_DELIVERY_PAUSED=false
